# ---- Node / Next.js (frontend) ----
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Python (backend) ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/
*.egg

# ---- Environment / secrets ----
# Broad rule first: ignore every .env* variant (.env, .env.local,
# .env.production, .env.production.local, .env.development, .env.test,
# etc. - present or future) so a new Next.js/tooling convention can never
# slip through un-ignored, then explicitly re-allow only the checked-in
# placeholder-only example files.
.env*
!.env.example

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Misc ----
*.log
coverage/

# Auto-regenerated by `next dev` on every start - not meaningful to version.
frontend/AGENTS.md
frontend/CLAUDE.md

# Paper-trading portfolio state (local simulation data, not source).
backend/data/paper_trading/
backend/data/watchlists/
backend/data/experiments/

# Local SQLite database (dev/test default - see app/db/base.py) and any
# backup snapshots taken by the JSON->Postgres migration script. Never the
# production database, which lives in a real PostgreSQL server.
backend/data/*.db
backend/data/*.db-journal
backend/data/backups/


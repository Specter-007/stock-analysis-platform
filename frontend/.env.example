# There is deliberately NO NEXT_PUBLIC_API_BASE_URL variable. The browser
# always calls this app's own origin (/api/*) - see lib/api.ts - which the
# Next.js Route Handler proxy (app/api/[...path]/route.ts) forwards
# server-side to BACKEND_URL below. This is true in both local dev and
# production; there is nothing to configure for the browser to work
# correctly. A NEXT_PUBLIC_* variable used to exist here and was removed
# after a real production incident: it is compiled into the browser
# bundle at BUILD time, and a wrong/stale/not-actually-empty value in a
# hosting dashboard made the browser call the backend directly, bypassing
# the proxy entirely with no error pointing at the actual cause. See
# docs/DEPLOYMENT.md.

# Server-only (deliberately NOT NEXT_PUBLIC_*) - the real backend URL the
# proxy above forwards to. Defaults to the local backend if unset, so
# local dev needs nothing set here; production sets this to the real
# Render URL.
# BACKEND_URL=https://your-backend.onrender.com

# Public base URL of this frontend itself - used only for SEO metadata
# (canonical URLs, sitemap.xml, robots.txt) in app/robots.ts, app/sitemap.ts,
# and app/layout.tsx's metadataBase. Not used for anything functional.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the FastAPI backend (see ../backend). Local dev: point this
# directly at the local backend. PRODUCTION: set this to an empty string
# instead (NEXT_PUBLIC_API_BASE_URL=) so the frontend calls its own origin
# (/api/*) and Next.js's rewrite proxy (next.config.ts) forwards to the
# real backend server-side - required for auth to work when the frontend
# and backend are on different domains (SameSite=Lax cookies are not sent
# on a genuine cross-site fetch). See docs/DEPLOYMENT.md.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only (deliberately NOT NEXT_PUBLIC_*) - the real backend URL used
# by the rewrite proxy above. Only meaningful in production; local dev
# calls the backend directly via NEXT_PUBLIC_API_BASE_URL instead and
# never needs this set.
# BACKEND_URL=https://your-backend.onrender.com

# Public base URL of this frontend itself - used only for SEO metadata
# (canonical URLs, sitemap.xml, robots.txt) in app/robots.ts, app/sitemap.ts,
# and app/layout.tsx's metadataBase. Not used for anything functional.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

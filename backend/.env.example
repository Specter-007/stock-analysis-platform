# --- Environment ---
# development | test | production. Several settings below are validated
# strictly (and the app refuses to start on an insecure default) only when
# this is "production" - see app/settings.py.
APP_ENV=development

# --- Database ---
# Production target is PostgreSQL. Local dev/test defaults to a SQLite file
# at backend/data/app.db if this is unset - see app/db/base.py and
# docs/DATABASE.md.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/stock_analyst

# --- Sessions / CSRF ---
# Signs CSRF tokens (app/auth/security.py). MUST be set to a real, private,
# random value in production - the app will refuse to start otherwise.
SESSION_SECRET=dev-insecure-session-secret-change-me
SESSION_TTL_DAYS=30
# Set to 1 to force the Secure cookie flag locally over HTTPS; always forced
# on automatically when APP_ENV=production.
SESSION_COOKIE_SECURE=0

# Comma-separated list of origins allowed to call this API (CORS).
# Defaults to the local Next.js dev server if unset. Must never contain "*"
# in production (credentialed CORS) - app/settings.py enforces this.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Email (see app/auth/email.py) ---
# "console": logs emails instead of sending them - safe for local dev/test,
# never claims a real email was delivered. "smtp": sends via a real server.
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@localhost
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO

# --- Rate limits (slowapi format: "<count>/<period>") ---
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_PASSWORD_RESET=3/minute
RATE_LIMIT_CONTACT=3/minute
RATE_LIMIT_EXPENSIVE_RESEARCH=20/minute

# --- Legacy JSON -> PostgreSQL migration (see scripts/migrate_json_to_db.py) ---
# Pre-existing single-user JSON data (watchlists, paper portfolios,
# experiments) is assigned to this account during migration since it has no
# associated user. Created automatically by the migration script if it
# doesn't already exist.
LEGACY_DATA_OWNER_EMAIL=legacy-import@localhost
